{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sp:inject",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/sp/particles"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.hc = (variable.color.r + variable.color.g + variable.color.b) > 0.004;variable.tr = variable.hc ? variable.color.r : 0.45;variable.tg = variable.hc ? variable.color.g : 1;variable.tb = variable.hc ? variable.color.b : 0.5;"
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.t = math.clamp(variable.particle_age / math.max(variable.particle_lifetime, 0.001), 0, 1);"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 8
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": 0.12,
        "surface_only": false,
        "direction": [
          "math.random(-1, 1)",
          "math.random(0, 1.5)",
          "math.random(-1, 1)"
        ]
      },
      "minecraft:particle_initial_speed": "math.random(0.4, 1.2)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.35, 0.7)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.8,
          0
        ],
        "linear_drag_coefficient": 2.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.05 + variable.particle_random_2 * 0.04) * (variable.t > 0.85 ? 1.4 : 1)",
          "(0.05 + variable.particle_random_2 * 0.04) * (variable.t > 0.85 ? 1.4 : 1)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            112,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(variable.tr + (1 - variable.tr) * 0.4)",
          "(variable.tg + (1 - variable.tg) * 0.4)",
          "(variable.tb + (1 - variable.tb) * 0.4)",
          0.85
        ]
      }
    }
  }
}
