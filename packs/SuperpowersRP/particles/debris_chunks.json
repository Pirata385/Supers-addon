{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sp:debris_chunks",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/sp/particles"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.hc = (variable.color.r + variable.color.g + variable.color.b) > 0.004;variable.tr = variable.hc ? variable.color.r : 0.55;variable.tg = variable.hc ? variable.color.g : 0.5;variable.tb = variable.hc ? variable.color.b : 0.45;variable.cs = math.clamp((variable.size > 0 ? variable.size : 1), 0.3, 3);"
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.t = math.clamp(variable.particle_age / math.max(variable.particle_lifetime, 0.001), 0, 1);"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.clamp(12 + math.clamp(variable.size > 0 ? variable.size : 1, 0.3, 3) * 4, 12, 24)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": "0.25 * math.clamp(variable.size > 0 ? variable.size : 1, 0.3, 3)",
        "surface_only": false,
        "direction": [
          "math.random(-1, 1)",
          "math.random(0.4, 1.4)",
          "math.random(-1, 1)"
        ]
      },
      "minecraft:particle_initial_speed": "math.random(2.5, 5.5) * math.sqrt(math.clamp(variable.size > 0 ? variable.size : 1, 0.3, 3))",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.0, 1.8)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -14,
          0
        ],
        "linear_drag_coefficient": 1,
        "rotation_drag_coefficient": 1
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.06,
        "coefficient_of_restitution": 0.3,
        "collision_drag": 6
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-540, 540)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.05 + variable.particle_random_2 * 0.07) * variable.cs * (variable.t < 0.8 ? 1 : (1 - variable.t) / 0.2)",
          "(0.05 + variable.particle_random_2 * 0.07) * variable.cs * (variable.t < 0.8 ? 1 : (1 - variable.t) / 0.2)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            "64 + math.mod(math.min(math.floor(variable.particle_random_4 * 4), 3), 2) * 8",
            "math.floor(math.min(math.floor(variable.particle_random_4 * 4), 3) / 2) * 8"
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.tr * (0.7 + variable.particle_random_3 * 0.4)",
          "variable.tg * (0.7 + variable.particle_random_3 * 0.4)",
          "variable.tb * (0.7 + variable.particle_random_3 * 0.4)",
          1
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
