{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sp:psi_aura",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/sp/particles"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.hc = (variable.color.r + variable.color.g + variable.color.b) > 0.004;variable.tr = variable.hc ? variable.color.r : 0.78;variable.tg = variable.hc ? variable.color.g : 0.36;variable.tb = variable.hc ? variable.color.b : 1;"
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.t = math.clamp(variable.particle_age / math.max(variable.particle_lifetime, 0.001), 0, 1);"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 7
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.5, 0.7)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "(variable.particle_random_1 < 0.14 ? 0 : 1) * (0.55 + variable.particle_random_4 * 0.35) * math.cos(variable.particle_random_1 * 360 + variable.particle_age * (200 + variable.particle_random_2 * 160) * (variable.particle_random_3 < 0.5 ? 1 : -1))",
          "(variable.particle_random_1 < 0.14 ? 0 : 1) * ((variable.particle_random_2 - 0.5) * 1.4 + variable.particle_age * 0.4)",
          "(variable.particle_random_1 < 0.14 ? 0 : 1) * (0.55 + variable.particle_random_4 * 0.35) * math.sin(variable.particle_random_1 * 360 + variable.particle_age * (200 + variable.particle_random_2 * 160) * (variable.particle_random_3 < 0.5 ? 1 : -1))"
        ]
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "variable.particle_random_1 < 0.14 ? 540 : 0"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.particle_random_1 < 0.14 ? 0.45 : 0.06 * (1 + 0.3 * math.sin(variable.particle_age * 900))",
          "variable.particle_random_1 < 0.14 ? 0.45 : 0.06 * (1 + 0.3 * math.sin(variable.particle_age * 900))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            "variable.particle_random_1 < 0.14 ? 192 : 128",
            "variable.particle_random_1 < 0.14 ? 96 : 0"
          ],
          "uv_size": [
            "variable.particle_random_1 < 0.14 ? 32 : 8",
            "variable.particle_random_1 < 0.14 ? 32 : 8"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.tr * math.sin(variable.t * 180)",
          "variable.tg * math.sin(variable.t * 180)",
          "variable.tb * math.sin(variable.t * 180)",
          "math.sin(variable.t * 180) * (variable.particle_random_1 < 0.14 ? 0.5 : 1)"
        ]
      }
    }
  }
}
