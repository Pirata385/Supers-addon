{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sp:shockwave",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/sp/particles"
      }
    },
    "curves": {
      "variable.shock_alpha": {
        "type": "linear",
        "input": "variable.particle_age / variable.particle_lifetime",
        "horizontal_range": 1,
        "nodes": [
          0.95,
          0.85,
          0.6,
          0.3,
          0.0
        ]
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.hc = (variable.color.r + variable.color.g + variable.color.b) > 0.004;variable.tr = variable.hc ? variable.color.r : 0.9;variable.tg = variable.hc ? variable.color.g : 0.9;variable.tb = variable.hc ? variable.color.b : 0.9;variable.sr = math.clamp((variable.radius > 0 ? variable.radius : 3), 0.2, 64);"
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.t = math.clamp(variable.particle_age / math.max(variable.particle_lifetime, 0.001), 0, 1);"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.45
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": 0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.sr * (1 - math.pow(1 - variable.t, 3)) + 0.1",
          "variable.sr * (1 - math.pow(1 - variable.t, 3)) + 0.1"
        ],
        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            32,
            32
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.tr",
          "variable.tg",
          "variable.tb",
          "variable.shock_alpha"
        ]
      }
    }
  }
}
