{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sp:lightning",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/sp/particles"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.hc = (variable.color.r + variable.color.g + variable.color.b) > 0.004;variable.tr = variable.hc ? variable.color.r : 1;variable.tg = variable.hc ? variable.color.g : 0.9;variable.tb = variable.hc ? variable.color.b : 0.45;"
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.t = math.clamp(variable.particle_age / math.max(variable.particle_lifetime, 0.001), 0, 1);"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.random_integer(2, 3)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": 0.3,
        "surface_only": false,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.12, 0.22)"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": 0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.35 * (0.8 + variable.particle_random_3 * 0.4)",
          "0.7 * (0.8 + variable.particle_random_3 * 0.4)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            "math.mod(math.floor(variable.particle_random_1 * 4 + variable.particle_age * 30), 4) * 16",
            96
          ],
          "uv_size": [
            16,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(variable.tr + (1 - variable.tr) * 0.35) * (math.mod(math.floor(variable.particle_age * 40 + variable.particle_random_2 * 4), 2) < 1 ? 1 : 0.35)",
          "(variable.tg + (1 - variable.tg) * 0.35) * (math.mod(math.floor(variable.particle_age * 40 + variable.particle_random_2 * 4), 2) < 1 ? 1 : 0.35)",
          "(variable.tb + (1 - variable.tb) * 0.35) * (math.mod(math.floor(variable.particle_age * 40 + variable.particle_random_2 * 4), 2) < 1 ? 1 : 0.35)",
          "(math.mod(math.floor(variable.particle_age * 40 + variable.particle_random_2 * 4), 2) < 1 ? 1 : 0.35)"
        ]
      }
    }
  }
}
