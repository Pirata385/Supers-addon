{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sp:reflect",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/sp/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 12
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.t = math.clamp(variable.particle_age / math.max(variable.particle_lifetime, 0.001), 0, 1);"
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": 0.1,
        "surface_only": false,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "(variable.particle_random_1 < 0.17) ? 0 : math.random(3, 6)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.particle_random_1 < 0.17) ? 0.18 : math.random(0.25, 0.45)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 4
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.particle_random_1 < 0.17) ? 0.9 * (1 + variable.t * 0.5) : 0.08 * (1 - variable.t * 0.5)",
          "(variable.particle_random_1 < 0.17) ? 0.9 * (1 + variable.t * 0.5) : 0.08 * (1 - variable.t * 0.5)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            "(variable.particle_random_1 < 0.17) ? 128 : 32",
            "(variable.particle_random_1 < 0.17) ? 32 : 0"
          ],
          "uv_size": [
            "(variable.particle_random_1 < 0.17) ? 32 : 16",
            "(variable.particle_random_1 < 0.17) ? 32 : 16"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "((variable.particle_random_1 < 0.17) ? 1 : 0.85) * math.pow(1 - variable.t, 2)",
          "((variable.particle_random_1 < 0.17) ? 0.85 : 0.5) * math.pow(1 - variable.t, 2)",
          "math.pow(1 - variable.t, 2)",
          "math.pow(1 - variable.t, 2)"
        ]
      }
    }
  }
}
