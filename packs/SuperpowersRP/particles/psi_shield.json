{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sp:psi_shield",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/sp/particles"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.sr = math.clamp((variable.radius > 0 ? variable.radius : 3), 0.5, 32);"
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.t = math.clamp(variable.particle_age / math.max(variable.particle_lifetime, 0.001), 0, 1);"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.clamp(math.pow(math.clamp(variable.radius > 0 ? variable.radius : 3, 0.5, 32), 2) * 1.6, 8, 36)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": "math.clamp(variable.radius > 0 ? variable.radius : 3, 0.5, 32)",
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "math.random(0, 0.15)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.5, 0.8)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.particle_random_1 < 0.4) ? 0.22 : 0.09",
          "(variable.particle_random_1 < 0.4) ? 0.22 : 0.09"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            "(variable.particle_random_1 < 0.4) ? 144 : 128 + math.min(math.floor(variable.t * 4), 3) * 16",
            "(variable.particle_random_1 < 0.4) ? 0 : 16"
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "((variable.particle_random_1 < 0.4) ? 0.6 : 0.85) * math.sin(variable.t * 180)",
          "((variable.particle_random_1 < 0.4) ? 0.45 : 0.6) * math.sin(variable.t * 180)",
          "math.sin(variable.t * 180)",
          "math.sin(variable.t * 180)"
        ]
      }
    }
  }
}
