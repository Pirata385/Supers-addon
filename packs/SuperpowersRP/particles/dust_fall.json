{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sp:dust_fall",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/sp/particles"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.hc = (variable.color.r + variable.color.g + variable.color.b) > 0.004;variable.tr = variable.hc ? variable.color.r : 0.6;variable.tg = variable.hc ? variable.color.g : 0.55;variable.tb = variable.hc ? variable.color.b : 0.5;"
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.t = math.clamp(variable.particle_age / math.max(variable.particle_lifetime, 0.001), 0, 1);"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 2
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_box": {
        "offset": [
          0,
          0,
          0
        ],
        "half_dimensions": [
          0.25,
          0.1,
          0.25
        ],
        "surface_only": false,
        "direction": [
          0,
          -1,
          0
        ]
      },
      "minecraft:particle_initial_speed": "math.random(0, 0.3)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.5, 0.9)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -5,
          0
        ],
        "linear_drag_coefficient": 1
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.03,
        "coefficient_of_restitution": 0,
        "collision_drag": 5,
        "expire_on_contact": true
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.03 + variable.particle_random_2 * 0.025) * (variable.t < 0.7 ? 1 : (1 - variable.t) / 0.3)",
          "(0.03 + variable.particle_random_2 * 0.025) * (variable.t < 0.7 ? 1 : (1 - variable.t) / 0.3)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            "192 + math.min(math.floor(variable.particle_random_4 * 4), 3) * 8",
            16
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.tr * (0.75 + variable.particle_random_3 * 0.35)",
          "variable.tg * (0.75 + variable.particle_random_3 * 0.35)",
          "variable.tb * (0.75 + variable.particle_random_3 * 0.35)",
          1
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
