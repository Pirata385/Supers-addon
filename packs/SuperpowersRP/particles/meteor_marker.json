{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sp:meteor_marker",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/sp/particles"
      }
    },
    "curves": {
      "variable.pulse": {
        "type": "catmull_rom",
        "input": "variable.particle_age / variable.particle_lifetime",
        "horizontal_range": 1,
        "nodes": [
          0.0,
          0.0,
          1.0,
          0.7,
          1.0,
          0.0,
          0.0
        ]
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.mr = math.clamp((variable.radius > 0 ? variable.radius : 3), 0.3, 64);"
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.t = math.clamp(variable.particle_age / math.max(variable.particle_lifetime, 0.001), 0, 1);"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.55
      },
      "minecraft:particle_initial_spin": {
        "rotation": 0,
        "rotation_rate": 45
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.mr * (1 + 0.04 * math.sin(variable.particle_age * 720))",
          "variable.mr * (1 + 0.04 * math.sin(variable.particle_age * 720))"
        ],
        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            96,
            32
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.pulse",
          "0.15 * variable.pulse",
          "0.08 * variable.pulse",
          "variable.pulse"
        ]
      }
    }
  }
}
