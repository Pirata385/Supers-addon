{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sp:fireball",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/sp/particles"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.bs = math.clamp((variable.size > 0 ? variable.size : 2), 0.3, 8);"
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.t = math.clamp(variable.particle_age / math.max(variable.particle_lifetime, 0.001), 0, 1);"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 30
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": "0.6 * math.clamp(variable.size > 0 ? variable.size : 2, 0.3, 8)",
        "surface_only": false,
        "direction": [
          "math.random(-1, 1)",
          "math.random(0.3, 1.5)",
          "math.random(-1, 1)"
        ]
      },
      "minecraft:particle_initial_speed": "((variable.particle_random_1 < 0.6) ? math.random(1.5, 4) : math.random(1, 2.5)) * math.sqrt(math.clamp(variable.size > 0 ? variable.size : 2, 0.3, 8))",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.particle_random_1 < 0.6) ? math.random(0.7, 1.3) : math.random(2.0, 3.0)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "(variable.particle_random_1 < 0.6) ? 1.5 : 2.0",
          0
        ],
        "linear_drag_coefficient": "(variable.particle_random_1 < 0.6) ? 2.5 : 1.2"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-30, 30)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.particle_random_1 < 0.6) ? (0.4 + variable.particle_random_3 * 0.3) * variable.bs * (0.6 + variable.t * 0.8) : (0.5 + variable.particle_random_3 * 0.3) * variable.bs * (0.8 + variable.t * 1.4)",
          "(variable.particle_random_1 < 0.6) ? (0.4 + variable.particle_random_3 * 0.3) * variable.bs * (0.6 + variable.t * 0.8) : (0.5 + variable.particle_random_3 * 0.3) * variable.bs * (0.8 + variable.t * 1.4)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "flipbook": {
            "base_UV": [
              "(variable.particle_random_1 < 0.6) ? 0 : 128",
              64
            ],
            "size_UV": [
              32,
              32
            ],
            "step_UV": [
              32,
              0
            ],
            "max_frame": 4,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(variable.particle_random_1 < 0.6) ? 1 : 0.2",
          "(variable.particle_random_1 < 0.6) ? 1 : 0.19",
          "(variable.particle_random_1 < 0.6) ? 1 : 0.18",
          "(variable.particle_random_1 < 0.6) ? 1 - variable.t * variable.t : 0.8 * (1 - variable.t) * math.min(variable.t * 4, 1)"
        ]
      }
    }
  }
}
