{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sp:sonic_boom",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/sp/particles"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.dl = math.sqrt(variable.dir.x * variable.dir.x + variable.dir.y * variable.dir.y + variable.dir.z * variable.dir.z);variable.ax = variable.dl > 0.0001 ? variable.dir.x / variable.dl : 0;variable.ay = variable.dl > 0.0001 ? variable.dir.y / variable.dl : 0;variable.az = variable.dl > 0.0001 ? variable.dir.z / variable.dl : 1;"
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.t = math.clamp(variable.particle_age / math.max(variable.particle_lifetime, 0.001), 0, 1);"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 2
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.5
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-60, 60)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.3 + 2.2 * (1 - math.pow(1 - variable.t, 2.5))) * (0.6 + variable.particle_random_1 * 0.4)",
          "(0.3 + 2.2 * (1 - math.pow(1 - variable.t, 2.5))) * (0.6 + variable.particle_random_1 * 0.4)"
        ],
        "facing_camera_mode": "direction_z",
        "direction": {
          "mode": "custom",
          "custom_direction": [
            "variable.ax",
            "variable.ay",
            "variable.az"
          ]
        },
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            64,
            32
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.95,
          0.97,
          1,
          "0.9 * math.pow(1 - variable.t, 1.6)"
        ]
      }
    }
  }
}
