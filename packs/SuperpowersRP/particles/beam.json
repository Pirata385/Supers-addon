{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sp:beam",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/sp/particles"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.hc = (variable.color.r + variable.color.g + variable.color.b) > 0.004;variable.tr = variable.hc ? variable.color.r : 1;variable.tg = variable.hc ? variable.color.g : 0.28;variable.tb = variable.hc ? variable.color.b : 0.08;variable.dl = math.sqrt(variable.dir.x * variable.dir.x + variable.dir.y * variable.dir.y + variable.dir.z * variable.dir.z);variable.ax = variable.dl > 0.0001 ? variable.dir.x / variable.dl : 0;variable.ay = variable.dl > 0.0001 ? variable.dir.y / variable.dl : 1;variable.az = variable.dl > 0.0001 ? variable.dir.z / variable.dl : 0;variable.bl = (variable.len > 0 ? variable.len : 2);variable.bw = (variable.width > 0 ? variable.width : 0.1);"
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.t = math.clamp(variable.particle_age / math.max(variable.particle_lifetime, 0.001), 0, 1);"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.1
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.bl * 0.5",
          "variable.bw"
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "custom",
          "custom_direction": [
            "variable.ax",
            "variable.ay",
            "variable.az"
          ]
        },
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            0,
            128
          ],
          "uv_size": [
            32,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.tr * (1 - variable.t * 0.6)",
          "variable.tg * (1 - variable.t * 0.6)",
          "variable.tb * (1 - variable.t * 0.6)",
          "(1 - variable.t * 0.6)"
        ]
      }
    }
  }
}
