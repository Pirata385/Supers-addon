{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sp:shockwave_air",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/sp/particles"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.hc = (variable.color.r + variable.color.g + variable.color.b) > 0.004;variable.tr = variable.hc ? variable.color.r : 0.92;variable.tg = variable.hc ? variable.color.g : 0.92;variable.tb = variable.hc ? variable.color.b : 0.95;variable.sr = math.clamp((variable.radius > 0 ? variable.radius : 2), 0.2, 64);"
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.t = math.clamp(variable.particle_age / math.max(variable.particle_lifetime, 0.001), 0, 1);"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.35
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.sr * (1 - math.pow(1 - variable.t, 3)) + 0.05",
          "variable.sr * (1 - math.pow(1 - variable.t, 3)) + 0.05"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            0,
            32
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.tr",
          "variable.tg",
          "variable.tb",
          "0.8 * math.pow(1 - variable.t, 1.3)"
        ]
      }
    }
  }
}
