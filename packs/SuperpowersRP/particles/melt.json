{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sp:melt",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/sp/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 4
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.t = math.clamp(variable.particle_age / math.max(variable.particle_lifetime, 0.001), 0, 1);"
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": 0.4,
        "surface_only": false,
        "direction": [
          "math.random(-0.2, 0.2)",
          -1,
          "math.random(-0.2, 0.2)"
        ]
      },
      "minecraft:particle_initial_speed": "math.random(0.2, 0.8)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.8, 1.3)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -9,
          0
        ],
        "linear_drag_coefficient": 0.4
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.04,
        "coefficient_of_restitution": 0,
        "collision_drag": 10
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.075 * (1 - variable.t * 0.4)",
          "0.075 * (1 - variable.t * 0.4)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            96,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "1 - math.pow(variable.t, 3)",
          "math.lerp(0.85, 0.3, variable.t) * (1 - math.pow(variable.t, 3))",
          "math.lerp(0.4, 0.05, variable.t) * (1 - math.pow(variable.t, 3))",
          "1 - math.pow(variable.t, 3)"
        ]
      }
    }
  }
}
