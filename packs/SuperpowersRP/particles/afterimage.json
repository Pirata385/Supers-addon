{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sp:afterimage",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/sp/particles"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.hc = (variable.color.r + variable.color.g + variable.color.b) > 0.004;variable.tr = variable.hc ? variable.color.r : 1;variable.tg = variable.hc ? variable.color.g : 0.86;variable.tb = variable.hc ? variable.color.b : 0.2;"
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.t = math.clamp(variable.particle_age / math.max(variable.particle_lifetime, 0.001), 0, 1);"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0.94,
          0
        ]
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.4
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.47 * (1 + variable.t * 0.08)",
          "0.94 * (1 + variable.t * 0.08)"
        ],
        "facing_camera_mode": "rotate_y",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            "160 + (variable.particle_random_1 < 0.5 ? 0 : 16)",
            96
          ],
          "uv_size": [
            16,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.tr * 0.85 + 0.15",
          "variable.tg * 0.85 + 0.15",
          "variable.tb * 0.85 + 0.15",
          "0.6 * (1 - variable.t)"
        ]
      }
    }
  }
}
