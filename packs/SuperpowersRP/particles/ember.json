{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sp:ember",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/sp/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 3
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.t = math.clamp(variable.particle_age / math.max(variable.particle_lifetime, 0.001), 0, 1);"
      },
      "minecraft:emitter_shape_box": {
        "offset": [
          0,
          0,
          0
        ],
        "half_dimensions": [
          0.3,
          0.15,
          0.3
        ],
        "surface_only": false,
        "direction": [
          "math.random(-0.3, 0.3)",
          1,
          "math.random(-0.3, 0.3)"
        ]
      },
      "minecraft:particle_initial_speed": "math.random(0.4, 0.9)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.85, 1.15)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(variable.particle_age * 360 + variable.particle_random_2 * 360) * 0.8",
          0.3,
          "math.cos(variable.particle_age * 300 + variable.particle_random_3 * 360) * 0.8"
        ],
        "linear_drag_coefficient": 1.2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.065 * (1 - variable.t * 0.6)",
          "0.065 * (1 - variable.t * 0.6)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            48,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(1 - variable.t) * (0.75 + 0.25 * math.sin(variable.particle_age * 1500 + variable.particle_random_2 * 360))",
          "math.lerp(0.9, 0.25, variable.t) * (1 - variable.t) * (0.75 + 0.25 * math.sin(variable.particle_age * 1500 + variable.particle_random_2 * 360))",
          "math.lerp(0.4, 0.04, variable.t) * (1 - variable.t) * (0.75 + 0.25 * math.sin(variable.particle_age * 1500 + variable.particle_random_2 * 360))",
          "(1 - variable.t)"
        ]
      }
    }
  }
}
