{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sp:water_splash",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/sp/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 16
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.t = math.clamp(variable.particle_age / math.max(variable.particle_lifetime, 0.001), 0, 1);"
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": 0.3,
        "surface_only": false,
        "direction": [
          "math.random(-1, 1)",
          "math.random(1.2, 2.2)",
          "math.random(-1, 1)"
        ]
      },
      "minecraft:particle_initial_speed": "(variable.particle_random_1 < 0.3) ? math.random(0.5, 1.2) : math.random(2.5, 5)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.particle_random_1 < 0.3) ? math.random(0.6, 1.0) : math.random(0.5, 0.9)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "(variable.particle_random_1 < 0.3) ? -1.5 : -14",
          0
        ],
        "linear_drag_coefficient": "(variable.particle_random_1 < 0.3) ? 3 : 0.5"
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.05,
        "coefficient_of_restitution": 0,
        "collision_drag": 1,
        "expire_on_contact": true
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.particle_random_1 < 0.3) ? (0.12 + variable.particle_random_2 * 0.1) * (1 + variable.t) : 0.05 + variable.particle_random_2 * 0.03",
          "(variable.particle_random_1 < 0.3) ? (0.12 + variable.particle_random_2 * 0.1) * (1 + variable.t) : 0.05 + variable.particle_random_2 * 0.03"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            "(variable.particle_random_1 < 0.3) ? 176 : 96",
            0
          ],
          "uv_size": [
            "(variable.particle_random_1 < 0.3) ? 16 : 8",
            "(variable.particle_random_1 < 0.3) ? 16 : 8"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(variable.particle_random_1 < 0.3) ? 1 : 0.6",
          "(variable.particle_random_1 < 0.3) ? 1 : 0.8",
          1,
          "(variable.particle_random_1 < 0.3) ? 0.8 * (1 - variable.t) : 0.85"
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
