{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sp:power_gain",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/sp/particles"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.hc = (variable.color.r + variable.color.g + variable.color.b) > 0.004;variable.tr = variable.hc ? variable.color.r : 0.55;variable.tg = variable.hc ? variable.color.g : 1;variable.tb = variable.hc ? variable.color.b : 0.45;"
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.t = math.clamp(variable.particle_age / math.max(variable.particle_lifetime, 0.001), 0, 1);"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 18,
        "max_particles": 40
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1.4
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.5, 0.8)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "(0.75 - (variable.emitter_age - variable.particle_age) * 0.12) * math.cos(((variable.emitter_age - variable.particle_age) * 400 + (variable.particle_random_1 < 0.5 ? 0 : 180) + variable.particle_age * 120))",
          "(variable.emitter_age - variable.particle_age) * 1.25 + variable.particle_age * 0.4",
          "(0.75 - (variable.emitter_age - variable.particle_age) * 0.12) * math.sin(((variable.emitter_age - variable.particle_age) * 400 + (variable.particle_random_1 < 0.5 ? 0 : 180) + variable.particle_age * 120))"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.12,
          0.12
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            "128 + math.min(math.floor(variable.t * 4), 3) * 16",
            16
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(variable.tr + (1 - variable.tr) * 0.3) * math.sin(variable.t * 180)",
          "(variable.tg + (1 - variable.tg) * 0.3) * math.sin(variable.t * 180)",
          "(variable.tb + (1 - variable.tb) * 0.3) * math.sin(variable.t * 180)",
          "math.sin(variable.t * 180)"
        ]
      }
    }
  }
}
