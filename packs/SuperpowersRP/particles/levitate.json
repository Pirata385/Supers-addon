{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sp:levitate",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/sp/particles"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.hc = (variable.color.r + variable.color.g + variable.color.b) > 0.004;variable.tr = variable.hc ? variable.color.r : 0.78;variable.tg = variable.hc ? variable.color.g : 0.36;variable.tb = variable.hc ? variable.color.b : 1;"
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.t = math.clamp(variable.particle_age / math.max(variable.particle_lifetime, 0.001), 0, 1);"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 4
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_disc": {
        "offset": [
          0,
          0.05,
          0
        ],
        "radius": 0.45,
        "plane_normal": [
          0,
          1,
          0
        ],
        "surface_only": false,
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_initial_speed": "math.random(0.6, 1.3)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.6, 1.0)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 0.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.055 * (1 - variable.t * 0.5)",
          "0.055 * (1 - variable.t * 0.5)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            128,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.tr * (math.min(variable.t * 5, 1) * (1 - variable.t))",
          "variable.tg * (math.min(variable.t * 5, 1) * (1 - variable.t))",
          "variable.tb * (math.min(variable.t * 5, 1) * (1 - variable.t))",
          "(math.min(variable.t * 5, 1) * (1 - variable.t))"
        ]
      }
    }
  }
}
