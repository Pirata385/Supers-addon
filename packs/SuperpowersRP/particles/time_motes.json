{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sp:time_motes",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/sp/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 6
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.t = math.clamp(variable.particle_age / math.max(variable.particle_lifetime, 0.001), 0, 1);"
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": 2.5,
        "surface_only": false,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "math.random(0.05, 0.2)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.5, 2.5)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 0.2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.045 + variable.particle_random_3 * 0.03",
          "0.045 + variable.particle_random_3 * 0.03"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            128,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.55 * math.sin(variable.t * 180) * (0.7 + 0.3 * math.sin(variable.particle_age * 400 + variable.particle_random_2 * 360))",
          "0.75 * math.sin(variable.t * 180) * (0.7 + 0.3 * math.sin(variable.particle_age * 400 + variable.particle_random_2 * 360))",
          "math.sin(variable.t * 180) * (0.7 + 0.3 * math.sin(variable.particle_age * 400 + variable.particle_random_2 * 360))",
          "math.sin(variable.t * 180) * (0.7 + 0.3 * math.sin(variable.particle_age * 400 + variable.particle_random_2 * 360))"
        ]
      }
    }
  }
}
