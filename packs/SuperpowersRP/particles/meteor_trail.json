{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sp:meteor_trail",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/sp/particles"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.ms = math.clamp((variable.size > 0 ? variable.size : 1), 0.2, 6);"
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.t = math.clamp(variable.particle_age / math.max(variable.particle_lifetime, 0.001), 0, 1);"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 3
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": "0.25 * math.clamp(variable.size > 0 ? variable.size : 1, 0.2, 6)",
        "surface_only": false,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "math.random(0.1, 0.4)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.particle_random_1 < 0.55) ? math.random(0.4, 0.7) : math.random(1.0, 1.6)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "(variable.particle_random_1 < 0.55) ? 0.2 : 0.6",
          0
        ],
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-60, 60)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.particle_random_1 < 0.55) ? (0.35 + variable.particle_random_2 * 0.15) * variable.ms * (1 - variable.t * 0.5) : (0.4 + variable.particle_random_2 * 0.2) * variable.ms * (1 + variable.t * 1.2)",
          "(variable.particle_random_1 < 0.55) ? (0.35 + variable.particle_random_2 * 0.15) * variable.ms * (1 - variable.t * 0.5) : (0.4 + variable.particle_random_2 * 0.2) * variable.ms * (1 + variable.t * 1.2)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "flipbook": {
            "base_UV": [
              "(variable.particle_random_1 < 0.55) ? 64 : 0",
              16
            ],
            "size_UV": [
              16,
              16
            ],
            "step_UV": [
              16,
              0
            ],
            "max_frame": 4,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(variable.particle_random_1 < 0.55) ? 1 : 0.25",
          "(variable.particle_random_1 < 0.55) ? 1 : 0.23",
          "(variable.particle_random_1 < 0.55) ? 1 : 0.22",
          "(variable.particle_random_1 < 0.55) ? 0.95 * (1 - variable.t * variable.t) : 0.7 * (1 - variable.t) * math.min(variable.t * 5, 1)"
        ]
      }
    }
  }
}
