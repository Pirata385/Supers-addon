{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sp:wind_streak",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/sp/particles"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.dl = math.sqrt(variable.dir.x * variable.dir.x + variable.dir.y * variable.dir.y + variable.dir.z * variable.dir.z);variable.ax = variable.dl > 0.0001 ? variable.dir.x / variable.dl : 0;variable.ay = variable.dl > 0.0001 ? variable.dir.y / variable.dl : 1;variable.az = variable.dl > 0.0001 ? variable.dir.z / variable.dl : 0;variable.wl = math.clamp((variable.len > 0 ? variable.len : 2), 0.1, 16);"
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.t = math.clamp(variable.particle_age / math.max(variable.particle_lifetime, 0.001), 0, 1);"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.random_integer(4, 6)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": 0.7,
        "surface_only": false,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.15, 0.25)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.wl * 0.5 * (0.5 + variable.particle_random_2 * 0.5)",
          0.018
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "custom",
          "custom_direction": [
            "variable.ax",
            "variable.ay",
            "variable.az"
          ]
        },
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            0,
            144
          ],
          "uv_size": [
            32,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "0.6 * (1 - variable.t) * math.min(variable.t * 8, 1)"
        ]
      }
    }
  }
}
