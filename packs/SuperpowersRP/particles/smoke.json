{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sp:smoke",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/sp/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 2
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.t = math.clamp(variable.particle_age / math.max(variable.particle_lifetime, 0.001), 0, 1);"
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": 0.2,
        "surface_only": false,
        "direction": [
          "math.random(-0.2, 0.2)",
          1,
          "math.random(-0.2, 0.2)"
        ]
      },
      "minecraft:particle_initial_speed": "math.random(0.5, 0.9)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.3, 1.7)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.3,
          0
        ],
        "linear_drag_coefficient": 0.8
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-40, 40)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.25 + variable.t * 0.45",
          "0.25 + variable.t * 0.45"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "flipbook": {
            "base_UV": [
              0,
              16
            ],
            "size_UV": [
              16,
              16
            ],
            "step_UV": [
              16,
              0
            ],
            "max_frame": 4,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.22,
          0.21,
          0.2,
          "0.85 * math.pow(1 - variable.t, 1.2) * math.min(variable.t * 6, 1)"
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
