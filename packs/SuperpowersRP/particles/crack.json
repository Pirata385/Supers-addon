{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sp:crack",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/sp/particles"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.ks = math.clamp((variable.size > 0 ? variable.size : 1.5), 0.2, 16);"
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.t = math.clamp(variable.particle_age / math.max(variable.particle_lifetime, 0.001), 0, 1);"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 2
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": 0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.ks * (0.55 + 0.45 * math.min(variable.t * 10, 1))",
          "variable.ks * (0.55 + 0.45 * math.min(variable.t * 10, 1))"
        ],
        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            "variable.particle_random_1 < 0.5 ? 192 : 224",
            32
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "(variable.t < 0.6 ? 1 : (1 - variable.t) / 0.4)"
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
